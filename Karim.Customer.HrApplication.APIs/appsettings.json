{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HRMSContext": "Server = .; Database = HRMSBase; Trusted_Connection = true; TrustServerCertificate = true; MultipleActiveResultSets = true",
    //"HRMSSecurityContext": "Server = .; Datebase = HRMSSecurity; Trusted_Connection = true; TrustServerCertificate = true; MultipleActiveResultSets = true"
  },
  "Urls": {
    "HRMSBaseUrl": "https://localhost:7179"
  },
  "Serilog": {
    //Usin here is for usin the packages that i will log with
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    //MinimumLevel is for declaring a level for startingg logging it has 2 props
    "MinimumLevel": {
      //this prop is for default level of logging and up like info => warning => errors => critical
      "Default": "Information",
      //this prop for selectin specific namespaces to log starting from another level then the defaault
      "Override": {
        //any name space start wit Microsoft start logging from Warning level 
        "Microsoft": "Warning",
        //any name space start wit System start logging from Warning level 
        "System": "Warning"
      }
    },
    //here we are trying to specify the way of showing the loggs 
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        //this prop for cofiuration for the loggin way
        "Args": {
          "connectionString": "Server = .; Database = HRMSBase; Trusted_Connection = true; TrustServerCertificate = true; MultipleActiveResultSets = true",
          "TableName": "SystemLogs",
          "AutoCreateSqlTable": true,
          "timeStamp": {
            "columnName": "TimeStamp",
            "ConvertToUtc": true
          }
        }
      }
    ]
  },
  "JwtConfigs": {
    "SecretKey": "pC:8dIUvAz[=HNkR%>e!?_BXR<Oy_$W4c#iJkn4T6hs",
    //It's the server that host the application (like the server url)
    "Issure": "BackUrl",
    //it's the server that host the client application (also server url)
    "Audience": "ClientUrl",
    "ExpiringTime":  15
  }
}
